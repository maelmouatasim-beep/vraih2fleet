# Copier vers apps/web/.env.local (jamais commité). Valeurs LOCALES de développement.
# Rôle lp_app (sans BYPASSRLS) : toutes les requêtes de l'application.
DATABASE_URL=postgres://lp_app:lp_app_local@localhost:5432/leaseplace
# Rôle lp_auth : Better-Auth uniquement.
DATABASE_URL_AUTH=postgres://lp_auth:lp_auth_local@localhost:5432/leaseplace
# Propriétaire : migrations et jeu de démonstration seulement (jamais à l'exécution).
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/leaseplace
# 32 caractères minimum : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
LP_DEMO_MODE=true
LOG_LEVEL=info
# Documents : répertoire local (dev/démo) et clé AES-256 en base64 (openssl rand -base64 32).
LP_STORAGE_DIR=.storage
LP_STORAGE_KEY=
