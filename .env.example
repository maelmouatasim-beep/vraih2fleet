# Copier ce fichier vers .env et remplir les valeurs.
# Les variables VITE_* sont inlinées dans le bundle par Vite : n'y mettre
# que des valeurs publiques (URL du projet, clé "anon/publishable").

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Identifiant du projet Supabase (Settings > General)
VITE_SUPABASE_PROJECT_ID=
# URL du projet Supabase, ex. https://<project-id>.supabase.co
VITE_SUPABASE_URL=
# Clé publique Supabase (Settings > API > "anon public")
VITE_SUPABASE_PUBLISHABLE_KEY=
# Emails admin séparés par des virgules (accès à la page Admin)
VITE_ADMIN_EMAILS=
# "true" pour le build d'aperçu hébergé uniquement (hash routing)
VITE_PREVIEW_HASH_ROUTER=

# ── Edge functions Supabase (secrets Deno, à définir via
#    `supabase secrets set`, jamais dans le bundle frontend) ────────────────
# Fournis automatiquement par la plateforme Supabase en déploiement :
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Passerelle IA Lovable (assistant-chat)
LOVABLE_API_KEY=
# Envoi d'emails (send-email)
SENDGRID_API_KEY=
# Jeton public Mapbox (get-mapbox-token)
MAPBOX_PUBLIC_TOKEN=
# Télématique (authenticate-telematics, fetch-telematics-vehicles,
# sync-telematics-data) ; URLs des API, valeurs par défaut des fournisseurs
GEOTAB_API_URL=
SAMSARA_API_URL=
