# Copier ce fichier vers .env et remplir les valeurs.
# Les variables VITE_* sont inlinées dans le bundle par Vite : n'y mettre
# que des valeurs publiques (URL du projet, clé "anon/publishable").

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Identifiant du projet Supabase (Settings > General)
VITE_SUPABASE_PROJECT_ID=
# URL du projet Supabase, ex. https://<project-id>.supabase.co
VITE_SUPABASE_URL=
# Clé publique Supabase (Settings > API > "anon public")
VITE_SUPABASE_PUBLISHABLE_KEY=
# "true" pour le build d'aperçu hébergé uniquement (hash routing)
VITE_PREVIEW_HASH_ROUTER=
# "true" pour réafficher la page API/webhooks (module reporté, défaut false)
VITE_FEATURE_PUBLIC_API=
# « true » quand l'envoi de courriels (SendGrid) est branché : retire l'avis
# « courriels pas encore activés » des Paramètres.
VITE_EMAILS_ACTIVE=

# ── Edge functions Supabase (secrets Deno, à définir via
#    `supabase secrets set`, jamais dans le bundle frontend) ────────────────
# Fournis automatiquement par la plateforme Supabase en déploiement :
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sécurité des fonctions (voir SECURITY.md)
# Origines autorisées pour CORS, séparées par des virgules
# ex. https://h2fleet.ca,https://www.h2fleet.ca,https://*.h2fleet.pages.dev
ALLOWED_ORIGINS=
# Secret des tâches planifiées (pg_cron -> header x-cron-secret)
CRON_SECRET=
# Secret des appels internes de fonction à fonction (x-internal-secret)
INTERNAL_FUNCTION_SECRET=
# Boîte interne qui reçoit les formulaires publics (défaut contact@h2fleet.ca)
CONTACT_INBOX_EMAIL=
# Base des liens dans les emails (défaut https://h2fleet.ca)
APP_BASE_URL=
# "true" pour activer api-gateway et le serveur MCP (défaut : 404)
FEATURE_PUBLIC_API=

# Intégrations
# API Claude d'Anthropic (fonction copilot) — secret Supabase, jamais côté navigateur
ANTHROPIC_API_KEY=
# Facultatif : modèle (défaut claude-opus-5-5) et interrupteur global de l'IA ("true" = tout désactivé)
ANTHROPIC_MODEL=
AI_FEATURES_DISABLED=
# Envoi d'emails (send-email)
SENDGRID_API_KEY=
# Expéditeur des courriels (domaine authentifié chez SendGrid) ; défaut no-reply@h2fleet.ca
EMAIL_FROM=
# Jeton public Mapbox (get-mapbox-token)
MAPBOX_PUBLIC_TOKEN=
# Chiffrement des identifiants télématiques (AES-256-GCM) : 32 octets en
# base64 (`openssl rand -base64 32`) ; ancienne clé pendant une rotation.
TELEMATICS_ENCRYPTION_KEY=
TELEMATICS_ENCRYPTION_KEY_PREVIOUS=
# Télématique (authenticate-telematics, fetch-telematics-vehicles,
# sync-telematics-data) ; URLs des API, valeurs par défaut des fournisseurs
GEOTAB_API_URL=
SAMSARA_API_URL=
