# Environnement des edge functions pour le PARCOURS E2E local uniquement
# (supabase functions serve --env-file supabase/tests/functions-e2e.env).
# Aucune valeur de production ici — ces secrets de test sont volontairement
# committés et repris par supabase/tests/helpers.ts.
CRON_SECRET=test-cron-secret
INTERNAL_FUNCTION_SECRET=test-internal-secret
ALLOWED_ORIGINS=http://localhost:8080
APP_BASE_URL=http://localhost:8080
CONTACT_INBOX_EMAIL=contact@h2fleet.ca
# Courriels : FAUX serveur SMTP local (scripts/mock-smtp.mjs, TLS implicite
# comme le port 465 d'IONOS) — aucun courriel ne quitte la machine. Son AC
# de test (SMTP_TLS_CA_TESTS_ONLY) est générée au démarrage et AJOUTÉE à ce
# fichier par la CI ; elle n'existe JAMAIS en production (le contrôle de
# santé du projet hébergé la refuse).
SMTP_HOST=host.docker.internal
SMTP_PORT=2465
SMTP_SECURE=true
SMTP_USER=noreply@h2fleet.test
SMTP_PASSWORD=mot-de-passe-de-test
# FEATURE_PUBLIC_API volontairement absent : l'API publique doit répondre 404.
# Parcours e2e : le copilote parle à un FAUX serveur Claude scripté
# (scripts/mock-anthropic.mjs) — clé factice, jamais une vraie clé ici.
ANTHROPIC_API_KEY=cle-de-test-factice
ANTHROPIC_BASE_URL=http://host.docker.internal:35563
# Clé de chiffrement des identifiants télématiques (TEST uniquement).
TELEMATICS_ENCRYPTION_KEY=dGVzdC10ZWxlbWF0aWNzLWtleS0zMi1vY3RldHMhISE=
