# Environnement des edge functions pour les tests LOCAUX uniquement
# (supabase functions serve --env-file supabase/tests/functions.env).
# Aucune valeur de production ici — ces secrets de test sont volontairement
# committés et repris par supabase/tests/helpers.ts.
CRON_SECRET=test-cron-secret
INTERNAL_FUNCTION_SECRET=test-internal-secret
ALLOWED_ORIGINS=http://localhost:8080
APP_BASE_URL=http://localhost:8080
CONTACT_INBOX_EMAIL=contact@h2fleet.ca
# SENDGRID_API_KEY volontairement absent : les tests ne déclenchent aucun
# envoi réel (pot de miel, erreurs de validation, erreurs d'auth).
# FEATURE_PUBLIC_API volontairement absent : l'API publique doit répondre 404.
# ANTHROPIC_API_KEY volontairement absent : le copilote doit répondre 503
# « service_non_configure » (message propre, aucune erreur).
# Clé de chiffrement des identifiants télématiques (TEST uniquement).
TELEMATICS_ENCRYPTION_KEY=dGVzdC10ZWxlbWF0aWNzLWtleS0zMi1vY3RldHMhISE=
